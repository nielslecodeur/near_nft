{
  "name": "Everkeep Terminal",
  "stage": "4 — Tokens, primitives et composants composés validés ; intégration aux pages réelles",
  "brand": {
    "accentSource": "src/orbite.css",
    "wordmarkSource": "public/fonts/space-grotesk.woff2, graisse 600, approche 0.18em",
    "wordmark": "/design/everkeep-wordmark.svg",
    "note": "Le logo est conservé en tracés vectoriels ; Inter et IBM Plex Mono sont utilisées dans les pages et les références."
  },
  "fonts": [
    {
      "family": "Inter",
      "role": "Interface et titres",
      "source": "/fonts/inter.woff2",
      "license": "/fonts/inter-OFL.txt",
      "weight": "400 700"
    },
    {
      "family": "IBM Plex Mono",
      "role": "Prix, pourcentages et statistiques",
      "source": "/fonts/ibmplexmono-regular.ttf",
      "license": "/fonts/ibmplexmono-OFL.txt",
      "weight": "400"
    }
  ],
  "tokens": {
    "color": {
      "bg": "#07080C",
      "s1": "#0D0F16",
      "s2": "#141722",
      "s3": "#1C2030",
      "text": "#F0F2EA",
      "muted": "#A6B0A8",
      "brand": "#B5F36B",
      "on-brand": "#07080C",
      "up": "#4FD498",
      "down": "#FF7B88",
      "border": "rgba(255,255,255,0.06)",
      "highlight": "rgba(255,255,255,0.05)",
      "hover": "rgba(255,255,255,0.04)",
      "grid": "rgba(255,255,255,0.025)",
      "brand-glow": "rgba(181,243,107,0.10)",
      "control-border": "#69716E",
      "overlay": "rgba(7,8,12,0.80)"
    },
    "font": {
      "ui": "Inter, sans-serif",
      "numeric": "'IBM Plex Mono', monospace"
    },
    "type": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "body": "1rem",
      "lead": "1.125rem",
      "title": "1.5rem",
      "heading": "2rem",
      "display": "2.5rem"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.65"
    },
    "tracking": {
      "title": "-0.03em",
      "body": "0em"
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px"
    },
    "radius": {
      "control": "8px",
      "surface": "12px",
      "feature": "20px"
    },
    "stroke": {
      "border": "1px",
      "focus": "2px"
    },
    "duration": {
      "fast": "180ms",
      "normal": "200ms",
      "expressive": "240ms"
    },
    "ease": {
      "ui": "cubic-bezier(.2,.8,.2,1)"
    },
    "shadow": {
      "bg": "none",
      "s1": "inset 0 1px 0 rgba(255,255,255,0.05), 0 12px 40px rgba(0,0,0,0.16)",
      "s2": "inset 0 1px 0 rgba(255,255,255,0.05), 0 16px 48px rgba(0,0,0,0.22)",
      "s3": "inset 0 1px 0 rgba(255,255,255,0.05), 0 24px 64px rgba(0,0,0,0.28)"
    },
    "opacity": {
      "noise": "0.035",
      "disabled": "0.45"
    },
    "texture": {
      "grid-size": "64px",
      "grain-size": "128px",
      "glow-falloff": "72%"
    },
    "layout": {
      "max": "1200px",
      "measure": "65ch",
      "wordmark-width": "176px",
      "wordmark-height": "24px",
      "touch-target": "44px",
      "swatch-height": "112px",
      "type-sample": "280px",
      "min-column": "240px",
      "glow-width": "640px",
      "glow-height": "320px",
      "spacing-unit": "8px",
      "dialog-max": "480px",
      "menu-min": "224px",
      "tooltip-max": "240px",
      "icon": "20px",
      "switch-width": "40px",
      "switch-height": "24px",
      "switch-thumb": "16px",
      "skeleton-line": "12px",
      "table-min": "880px",
      "chart-height": "240px",
      "sidebar-width": "208px",
      "trade-width": "320px",
      "card-min": "224px",
      "art-ratio": "4 / 3",
      "spark-width": "96px",
      "spark-height": "32px",
      "header-blur": "12px"
    },
    "effect": {
      "tilt": "6deg",
      "perspective": "960px",
      "art-scale": "1.04",
      "parallax": "8px",
      "foil-opacity": "0.28",
      "glare-opacity": "0.16",
      "stagger": "40ms",
      "foil-angle": "120deg"
    },
    "layer": {
      "navigation": "30",
      "overlay": "40",
      "dialog": "50",
      "floating": "60"
    },
    "breakpoint": {
      "mobile": "640px",
      "tablet": "960px"
    }
  }
}
