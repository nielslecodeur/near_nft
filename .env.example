VITE_RPC_URL=https://rpc.testnet.near.org
VITE_COLLECTION_ID=
VITE_ASSET_ID=
VITE_STRATEGY_ID=
# Never add a private key to a VITE_ variable.
NEAR_TESTNET_RPC=https://rpc.testnet.near.org
# Deployment script reads the testnet signer key from the local NEAR credentials directory.
# Optional override: absolute path to the legacy NEAR credential JSON (account_id, private_key).
# NEAR_CREDENTIAL_FILE=/absolute/path/to/parent.testnet.json
