# Public testnet configuration. Never put a secret in a VITE_ variable.
VITE_RPC_URL=https://test.rpc.fastnear.com
# Current contract addresses and code hashes are in public/testnet.json.
VITE_COLLECTION_ID=
VITE_ASSET_ID=
VITE_STRATEGY_ID=
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com
# Absolute credential path OUTSIDE the repository, server/CLI only.
# Default: ~/.near-credentials/testnet/everkeep-deployer.json
# NEAR_CREDENTIAL_FILE=/home/your-user/.near-credentials/testnet/everkeep-deployer.json
EVERKEEP_TESTNET_WORKER_PORT=8793
# Sandbox-only initial prices. Live prices are read from the deployed contract.
EVERKEEP_TRADFI_PRICE=15000000000000000000000
EVERKEEP_CRYPTO_PRICE=20000000000000000000000
EVERKEEP_LIQUIDITY_PRICE=10000000000000000000000
# Optional server-only HTTPS analysis adapter. Empty = deterministic demo, no AI.
EVERKEEP_ANALYSIS_ENDPOINT=
EVERKEEP_ANALYSIS_KEY=
# Shell launchers read the process environment; they do not load .env.
# Legacy local demos: ?mode=local uses API 8792; ?session=orbite uses 8791.
